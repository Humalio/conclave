{
  "name": "agent-hub-server",
  "version": "1.0.0",
  "description": "Conclave server",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run && npm run test:helper",
    "test:helper": "node scripts/test-helper.mjs ../deploy/client/agent-hub-headers.test.mjs ../deploy/client/setup.test.mjs ../deploy/client/codex.test.mjs ../deploy/client/codex-wake.test.mjs ../deploy/client/codex-wake-start.test.mjs ../deploy/client/conclave.test.mjs ../deploy/client/legacy-leftovers.test.mjs ../deploy/client/connector-hardware.test.mjs ../deploy/client/connector-wake.test.mjs ../deploy/client/connector-wake-wiring.test.mjs ../deploy/client/connector-stream.test.mjs ../deploy/client/connector-restore.test.mjs ../deploy/client/connector-codex-commit.test.mjs ../deploy/client/connector-reminder.test.mjs ../deploy/client/connector-profiles.test.mjs ../deploy/client/connector-context.test.mjs ../deploy/client/usage.test.mjs ../deploy/client/connector-service.test.mjs ../deploy/client/connector-hardened.test.mjs ../deploy/client/connector-onboarding.test.mjs ../deploy/client/connector-screen.test.mjs ../deploy/client/connector-isolation.test.mjs ../deploy/client/vault-sync-connector.test.mjs ../deploy/client/uninstall.test.mjs ../deploy/client/migrate.test.mjs ../deploy/client/transfers-config.test.mjs ../deploy/client/transfers-path.test.mjs ../deploy/client/transfers-agent-send.test.mjs ../deploy/client/transfers-gaps.test.mjs ../deploy/client/transfers-transfer.test.mjs ../deploy/client/connector-gap-rest.test.mjs ../deploy/client/connector-one-prompt.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:hub": "node scripts/dev-hub.mjs",
    "dev:seed": "node ../eval/run.mjs --hub",
    "story": "node ../eval/run.mjs"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.8",
    "mermaid": "12.2.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
